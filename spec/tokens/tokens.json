{
  "$schema": "planoa-tokens-v1",
  "description": "Design token source of truth (blueprint §9). Generated into Swift constants (PlanoaUI) and CSS variables (web) by the token pipeline — never hand-edit the generated files.",
  "color": {
    "neutral": {
      "comment": "Warm gray ramp (§9.6) — not blue-gray. 0 = lightest.",
      "0": "#FAF9F7",
      "50": "#F4F2EF",
      "100": "#E8E5E0",
      "200": "#D3CFC8",
      "300": "#B4AFA6",
      "400": "#8E887E",
      "500": "#6B655C",
      "600": "#4E4942",
      "700": "#37332E",
      "800": "#23201D",
      "900": "#161412",
      "950": "#0E0E10"
    },
    "accent": {
      "comment": "Six curated accents (§9.6); user picks one; default teal.",
      "teal": { "light": "#0F766E", "dark": "#2DD4BF" },
      "indigo": { "light": "#4338CA", "dark": "#818CF8" },
      "plum": { "light": "#86198F", "dark": "#E879F9" },
      "ochre": { "light": "#A16207", "dark": "#FACC15" },
      "forest": { "light": "#166534", "dark": "#4ADE80" },
      "slate": { "light": "#334155", "dark": "#94A3B8" }
    },
    "priority": {
      "comment": "Fixed semantics (§9.6). P4 has no color.",
      "p1": { "light": "#C2410C", "dark": "#FB923C" },
      "p2": { "light": "#B45309", "dark": "#FBBF24" },
      "p3": { "light": "#1D4ED8", "dark": "#60A5FA" }
    },
    "project": {
      "comment": "12 curated muted project tones (§9.6).",
      "stone": "#78716C", "clay": "#B45309", "rose": "#BE185D", "grape": "#7E22CE",
      "indigo": "#4338CA", "sky": "#0369A1", "teal": "#0F766E", "moss": "#4D7C0F",
      "forest": "#166534", "sand": "#A16207", "cocoa": "#7C2D12", "graphite": "#334155"
    },
    "surface": {
      "light": { "background": "{color.neutral.0}", "card": "#FFFFFF", "hairline": "{color.neutral.100}" },
      "dark": { "background": "{color.neutral.950}", "card": "#1A191C", "hairline": "#2A282C" }
    }
  },
  "spacing": {
    "comment": "4pt base grid (§9.3).",
    "1": 4, "2": 8, "3": 12, "4": 16, "5": 20, "6": 24, "8": 32, "10": 40, "12": 48
  },
  "radius": {
    "card": 16,
    "chip": 8,
    "sheet": 20,
    "control": 10
  },
  "type": {
    "comment": "Four-size scale (§9.2). iOS maps to SF Pro text styles; web to Inter.",
    "largeTitle": { "size": 30, "weight": 700, "tracking": -0.4 },
    "headline": { "size": 17, "weight": 600, "tracking": -0.2 },
    "body": { "size": 15, "weight": 400, "tracking": 0 },
    "caption": { "size": 12, "weight": 500, "tracking": 0.1 },
    "numerals": "tabular"
  },
  "layout": {
    "taskRowMinHeight": { "ios": 46, "web": 40 },
    "listMaxWidth": 680,
    "homeGridMaxWidth": 1200,
    "widgetPadding": 16
  },
  "motion": {
    "comment": "Confirm, never decorate (§9.8).",
    "fast": 150,
    "standard": 200,
    "slow": 250,
    "widgetStaggerDelay": 30,
    "curveWeb": "cubic-bezier(0.2, 0, 0, 1)"
  }
}
